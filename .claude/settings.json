{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run eval)",
      "Bash(npm run models)",
      "Bash(npm run dev)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-secrets.mjs" }]
      }
    ]
  }
}
