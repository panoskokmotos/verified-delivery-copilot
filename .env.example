# Nebius Token Factory (https://tokenfactory.nebius.com) - required for live mode
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron models. Run `npm run models` to see exact IDs on your account.
NEMOTRON_VISION_MODEL=nvidia/Nemotron-3-Nano-Omni
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_WRITER_MODEL=nvidia/Nemotron-3-Nano-30B-A3B

# Optional: Tavily web search to confirm the nonprofit is real
TAVILY_API_KEY=
