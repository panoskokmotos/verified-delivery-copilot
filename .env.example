# Nebius Token Factory (https://tokenfactory.nebius.com) - required for live mode
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Models on Token Factory. Run `npm run models` to see exact IDs on your account.
# Vision uses Gemma 3 because Nemotron Nano Omni is not on Token Factory yet.
NEMOTRON_VISION_MODEL=google/gemma-3-27b-it
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_WRITER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: Tavily web search to confirm the nonprofit is real
TAVILY_API_KEY=
# Stop Tavily searches when this many credits are left (default 100)
TAVILY_CREDIT_RESERVE=100

# Hard stop on Nebius model calls per day (a verification makes 3 or 4)
NEBIUS_MAX_CALLS_PER_DAY=300

# Signs check results so a nonprofit can confirm them. Required in production: openssl rand -hex 32
RECEIPT_SECRET=
# Stop saving verifications past this many a month (Vercel Blob free tier allows 2,000 writes)
MAX_VERIFICATIONS_PER_MONTH=300

# Server-to-server API (/api/v1/verify). Comma-separated keys; leave empty to keep the API off
VDC_API_KEYS=
NEMOTRON_VISION_FALLBACK=openbmb/MiniCPM-V-4_5
